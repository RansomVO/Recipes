<!-- Include entities to be used in the xml -->
<!DOCTYPE Recipe [
	<!ENTITY % externalEntities SYSTEM "/entities.dtd">
	%externalEntities;
]>

<Recipe xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="recipe.xsd">
	<LastModified year="2025" month="6" day="6" />
	<Title>Pumpkin Pie</Title>
	<Yields>2 9&inches; Pies</Yields>
	<Source>
		From the Kitchen of Bobbi Beagley
		<Note>Jennie's Mom</Note>
	</Source>

	<Description>
		When Jennie and Ransom were first married, they each felt that their mother's pumpkin pie recipe was the best.
		So, we had a bake-off.
		In the end, it was decided that Ransom's mom's recipe looked the best, but that Jennie's mom's tasted the best.
		So, Jennie's mom's is the one we make each year.
	</Description>

	<Ingredients>
		<section>
			<ingredient>Pumpkin <amount>1 29-oz. Can </amount></ingredient>
			<ingredient>Evaporated Milk <amount>2 12-fl. Oz. Cans </amount></ingredient>
			<ingredient>Sugar <amount>2 Cups</amount></ingredient>
			<ingredient>Eggs <amount>4</amount></ingredient>
			<ingredient>Salt <amount>1 teaspoon</amount></ingredient>
			<ingredient>Cinnamon <note>ground</note><amount>3 teaspoons</amount></ingredient>
			<ingredient>Nutmeg <note>ground</note><amount>1 teaspoon</amount></ingredient>
			<ingredient>Ginger <note>ground</note><amount>1 teaspoon</amount></ingredient>
			<ingredient>Allspice <note>ground</note><amount>1 teaspoon</amount></ingredient>
			<ingredient>Cloves <note>ground</note><amount>1 teaspoon</amount></ingredient>
		</section>
	</Ingredients>

	<Instructions>
		<section>
			<instruction>Preheat oven to 425&deg;.</instruction>
			<instruction>Mix all ingredients with a beater until smooth.</instruction>
			<instruction>Pour into pie pans with uncooked pie crust.</instruction>
			<instruction>Bake at 425&deg; for 15 minutes.</instruction>
			<instruction>Reduce temperature to 350&deg; and bake for an additional 35 minutes.</instruction>
		</section>
	</Instructions>

	<Notes>
		<note>
			You
			<span class="SUPER_EMPHASIZE">cannot</span>
			serve pumpkin pie without whipped cream, or vanilla ice cream.
			<br />
			<span class="HIGHLIGHT">(Or both &smiley;)</span>
		</note>
	</Notes>
</Recipe>
