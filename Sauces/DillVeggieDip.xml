<!-- Include entities to be used in the xml -->
<!DOCTYPE Recipe [
	<!ENTITY % externalEntities SYSTEM "/entities.dtd">
	%externalEntities;
]>

<Recipe xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="recipe.xsd">
	<LastModified year="2025" month="3" day="31" />
	<Title>Dill Veggie Dip</Title>
	<Yields>1 Pint</Yields>
	<Source>A VanOrman Original</Source>

	<Description>This dip is ideal for veggie trays.</Description>

	<Ingredients>
		<section>
			<ingredient>Sour Cream<amount>1 Cup</amount></ingredient>
			<ingredient>Mayonnaise<amount>1 Cup</amount></ingredient>
			<ingredient>Dill Weed<amount>1 teaspoon</amount></ingredient>
			<ingredient>Bon Ap&eacute;tite<amount>2 teaspoons</amount></ingredient>
			<ingredient>Scallions<note>Green Onions</note><amount>5</amount></ingredient>
		</section>
	</Ingredients>

	<Instructions>
		<section>
			<instruction>Chop the Scallions into very small pieces.</instruction>
			<instruction>Mix all ingredients well.</instruction>
		</section>
	</Instructions>

	<Notes>
		<note>Bon Ap&eacute;tite is a spice you can find near the Ginger powder, etc.</note>
		<note>
			Do <span class="SUPER_EMPHASIZE">not</span> use fat-free mayonnaise!
			<br />
			It will cause the dip to become a clumpy mess.
		</note>
		<note>
			Do <span class="SUPER_EMPHASIZE">not</span> substitute Miracle Whip or "salad dressing" for the mayonnaise!
			<br />
			It changes the taste negatively.
		</note>
	</Notes>
</Recipe>
