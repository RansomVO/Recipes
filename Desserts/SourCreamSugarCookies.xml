<!-- Include entities to be used in the xml -->
<!DOCTYPE Recipe [
	<!ENTITY % externalEntities SYSTEM "/entities.dtd">
	%externalEntities;
]>

<Recipe xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="recipe.xsd">
	<LastModified year="2025" month="6" day="6" />
	<Title>Sour Cream Sugar Cookies</Title>
	<Yields>About <span class="TODO">???</span></Yields>
	<Source>
		From the Kitchen of Heather Johnson
		<Note>From Issaquah 5th Ward</Note>
	</Source>

	<Description>We have had many really good recipes for sugar cookies. But this recipe is the best we have ever had.</Description>

	<Ingredients>
		<section id="IngredientsCookies" title="Cookies">
			<ingredient>Sugar <amount>2 Cups</amount></ingredient>
			<ingredient>Butter <note>Softened</note><amount>1 Cup <note>2 Sticks</note></amount></ingredient>
			<ingredient>Eggs <amount>3</amount></ingredient>
			<ingredient>Sour Cream <amount>1 Cup</amount></ingredient>
			<ingredient>Vanilla <amount>1 teaspoon</amount></ingredient>
			<ingredient>Baking Soda <amount>1 teaspoon</amount></ingredient>
			<ingredient>Flour <amount>6&frac12; Cups</amount></ingredient>
			<ingredient>Salt <amount>1 teaspoon</amount></ingredient>
		</section>
		<section id="IngredientsFrosting" title="Frosting">
			<ingredient>Butter <note>Softened</note><amount>&frac12; Cup <note>1 Stick</note></amount></ingredient>
			<ingredient>Cream Cheese <amount>1 8-oz. Package </amount></ingredient>
			<ingredient>Vanilla <amount>1 teaspoon</amount></ingredient>
			<ingredient>Powdered Sugar <amount>4 Cups</amount></ingredient>
			<ingredient>Food Coloring <note>Optional</note><amount>A Few Drops</amount></ingredient>
			<ingredient>Milk <amount><note>as needed</note></amount></ingredient>
		</section>
	</Ingredients>

	<Instructions>
		<section id="InstructionsCookies" title="Cookies">
			<instruction>Preheat oven to 350&deg;.</instruction>
			<instruction>Cream Butter and Sugar together.</instruction>
			<instruction>Stir in Eggs.</instruction>
			<instruction>Stir in Sour Cream and Vanilla.</instruction>
			<instruction>Stir in the rest of the ingredients.</instruction>
			<instruction>Flatten dough between plastic wrap and refrigerate several hours until cold/hard.</instruction>
			<instruction>Roll dough to &frac14;&inches; thick, cut with cookie cutters and place on a greased cookie sheet.</instruction>
			<instruction>Bake at 350&deg; for 10 minutes.</instruction>
			<instruction>Let cool, then frost.</instruction>
		</section>
		<section id="InstructionsFrosting" title="Frosting">
			<instruction>Combine Butter, Cream Cheese and Vanilla and beat until smooth.</instruction>
			<instruction>Gradually add Powdered Sugar while beating.</instruction>
			<instruction>If mixture is too thick to spread, add a small amount of Milk, &frac12; teaspoon at a time.</instruction>
		</section>
	</Instructions>

	<Notes>
		<note>
			When a recipe says <span class="EMPHASIZE">Softened</span> Butter, it means butter at room temperature.
			Do <span class="SUPER_EMPHASIZE">NOT</span> melt the Butter.
			It changes the consistency of the results to a sticky mess.
		</note>
		<note>If you want to have plain white frosting, use colorless Vanilla.</note>
	</Notes>
</Recipe>
