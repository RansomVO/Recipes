<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="../recipe.xsl"?>
<!-- Include entities to be used in the xml -->
<!DOCTYPE Recipe [
	<!ENTITY section SYSTEM "section.xml">
	<!ENTITY % externalEntities SYSTEM "/entities.dtd">
	%externalEntities;
]>

<Recipe>
	<Title>Robert Redford Dessert</Title>
	<Yields>12-16 servings</Yields>
	<Source>From the kitchen of Bobbi Beagley</Source>
	<Note>Jennie's Mom</Note>

	&section;
	<LastModified year="2025" month="6" day="6" />

	<Description id="Description">
		Originally, this was called "Next Best Thing To Robert Redford".
		However, that is a mouthful, so everybody just started calling it "Robert Redford", which is just as well because our kids have no idea who Robert Redford was.
	</Description>

	<Ingredients id="Ingredients">
		<section id="IngredientsCrust" title="Crust">
			<ingredient name="Flour" amount="1 Cup" />
			<ingredient name="Butter" amount="&frac12; Cup" amountNote="1 Stick" />
			<ingredient name="Pecans" nameNote="finely chopped" amount="1 Cup" />
		</section>
		<section id="IngredientsBottomLayer" title="Bottom Layer">
			<ingredient name="Cream Cheese" nameNote="softened" amount="1 8-oz. Package" />
			<ingredient name="Powdered Sugar" amount="1 Cup" />
			<ingredient name="Whipped Topping" nameNote="thawed" amount="8 Oz." />
		</section>
		<section id="IngredientsTopLayer" title="Top Layer">
			<ingredient name="Chocolate Instant Pudding Mix" amount="4 Ounces" />
			<ingredient name="Vanilla Instant Pudding Mix" amount="4 Ounces" />
			<ingredient name="Milk" amount="3 Cups" />
		</section>
		<section id="IngredientsTopLayer" title="Top Layer">
			<ingredient name="Milk Chocolate Candy Bar" nameNote="grated" amount="1&frac12;-oz. Bar" />
		</section>
	</Ingredients>

	<Instructions id="Instructions">
		<section id="InstructionsCrust" title="Crust">
			<instruction>Mix Flour, Butter and Pecans until crumbly.</instruction>
			<instruction>Press into 9&inch; &by; 13&inch; pan and bake at 350&deg; for 20 minutes.</instruction>
			<instruction>Cool completely.</instruction>
		</section>
		<section id="InstructionsBottomLayer" title="Bottom Layer">
			<instruction>Beat Cream Cheese and Powdered Sugar on high with a mixer until smooth.</instruction>
			<instruction>Fold in half of the Whipped Topping.</instruction>
			<instruction>Spread over cooled crust.</instruction>
		</section>
		<section id="InstructionsTopLayer" title="Top Layer">
			<instruction>Mix the Puddings with the Milk, beat slowly with mixer until smooth (&approx;2 minutes).</instruction>
			<instruction>Spread on top of Bottom Layer.</instruction>
			<instruction>Let stand a few minutes, then spoon remaining Whipped Topping over top and spread carefully.</instruction>
		</section>
		<section id="InstructionsFinishingTouch" title="Finishing Touch">
			<instruction>Sprinkle with grated Milk chocolate bar.</instruction>
			<instruction>Cover and refrigerate until ready to serve.</instruction>
		</section>
	</Instructions>
</Recipe>
