<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="../recipe.xsl"?>
<!-- Include entities to be used in the xml -->
<!DOCTYPE Recipe [
	<!ENTITY % externalEntities SYSTEM "/entities.dtd">
	%externalEntities;
]>

<Recipe xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../recipe.xsd">
	<Title>Gluten-Free Bread Machine Bread</Title>
	<Yields>1 Loaf</Yields>
	<Source>A VanOrman Original</Source>
	<LastModified year="2025" month="4" day="2" />

	<Description>
		<span class="TODO">This recipe is too liquidy.
		It boiled over and made a mess.
		Need to make another attempt.</span>
	</Description>

	<Ingredients>
		<section>
			<ingredient>Eggs<amount>3</amount></ingredient>
			<ingredient>Milk<amount>2 Cups</amount></ingredient>
			<ingredient>Oil<amount>&frac14; Cup</amount></ingredient>
			<ingredient>Apple Cider Vinegar<amount>1 Tablespoon</amount></ingredient>
			<ingredient>Gluten-Free All Purpose Baking Flour<amount>3 Cups</amount></ingredient>
			<ingredient>Sugar<amount>3 Tablespoons</amount></ingredient>
			<ingredient>Salt<amount>1&frac12; teaspoons</amount></ingredient>
			<ingredient>Xanthan Gum<amount>1 Tablespoon</amount></ingredient>
			<ingredient>Yeast<amount>1 Tablespoon</amount></ingredient>
		</section>
	</Ingredients>

	<Instructions>
		<section>
			<instruction>
				Add ingredients to bread machine, in this order, without mixing:
				<ol>
					<li>Eggs, Milk, Oil and Vinegar</li>
					<li>All other dry ingredients, except Yeast</li>
					<li>Yeast</li>
				</ol>
			</instruction>
			<instruction>Cook using settings for Rapid and Light Crust.</instruction>
		</section>
	</Instructions>

	<Modifications>
		<modification>Instead of Gluten-Free All Purpose Baking Flour, you can use:</modification>
		<modification>2 Cups Rice Flour.</modification>
		<modification>&frac12; Cup Potato Starch.</modification>
		<modification>&frac12; Cup Tapioca Flour or Soy Flour.</modification>
		<modification>&frac13; Cup Corn Starch.</modification>
	</Modifications>
</Recipe>
